# Database
DATABASE_URL=postgresql://pipenexo_user:password@localhost:5432/pipenexo_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your_access_token_secret_change_in_production_32_chars_minimum
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production_32_chars_minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,https://pipenexo.com.br,https://app.pipenexo.com.br

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# Storage (S3/Cloudflare R2)
STORAGE_PROVIDER=r2
STORAGE_BUCKET=pipenexo-documents
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key
STORAGE_SECRET_KEY=your_r2_secret_key
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_CDN_URL=https://your-cdn.example.com

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@pipenexo.com.br

# Payment Gateway (Stripe)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/pipenexo/app.log

# Monitoring
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Feature Flags
ENABLE_HEALTH_REQUESTS=true
ENABLE_CLAIMS=true
ENABLE_RENEWALS=true
ENABLE_BULK_IMPORT=true

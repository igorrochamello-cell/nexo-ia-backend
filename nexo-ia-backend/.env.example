# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o ".env" de verdade — ele já está no .gitignore.

# --- Banco de dados --------------------------------------------------------
# Postgres "de verdade" (não SQLite). Em produção, aponte para o Postgres
# gerenciado que você escolher (RDS, Supabase, Railway, Neon, etc.) — o
# schema (prisma/schema.prisma) não muda, só essa URL.
DATABASE_URL="postgresql://postgres:SENHA_AQUI@localhost:5432/nexo_ia_dev"

# --- Autenticação -----------------------------------------------------------
# Segredo usado para assinar os tokens JWT de sessão. Gere um valor aleatório
# forte (ex: `openssl rand -hex 32`) — nunca reaproveite o exemplo abaixo.
JWT_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes-ou-mais"
JWT_EXPIRES_IN="8h"

# --- OpenAI -------------------------------------------------------------
# Chave da API oficial da OpenAI. Fica SOMENTE aqui (variável de ambiente do
# backend) — nunca é enviada ao frontend, nunca aparece em log, nunca é
# commitada. Ver src/ia/openaiClient.ts.
OPENAI_API_KEY="sk-..."
# Modelo usado pela Responses API. gpt-4.1-mini é um bom padrão custo/qualidade
# para copiloto de CRM; troque para gpt-4.1 se precisar de mais raciocínio.
OPENAI_MODEL="gpt-4.1-mini"

# --- Servidor -----------------------------------------------------------
PORT=3333
# Origem(ns) do frontend autorizadas a chamar esta API (separadas por vírgula).
# Para testar com frontend-reference/nexo-ia-chat-demo.html servido localmente
# (ver README, seção "Testar com a interface de chat"), use a origem do
# servidor estático que você usar para abri-lo — ex: "http://localhost:8080".
CORS_ORIGIN="http://localhost:5173"
